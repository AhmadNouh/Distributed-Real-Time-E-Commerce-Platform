									"pm.test('200 OK', function () { pm.response.to.have.status(200); });",
									"var body = pm.response.json();",
									"pm.test('the details carry a stock block from the warehouse', function () {",
									"    pm.expect(body.data).to.have.property('available_quantity');",
									"    pm.expect(body.data).to.have.property('stock_status');",
									"});",
									"pm.test('the warehouse answered (stock_status = available)', function () {",
									"    pm.expect(body.data.stock_status).to.eql('available');",
									"    pm.expect(Number(body.data.available_quantity)).to.be.at.least(0);",
									"});",
									"pm.collectionVariables.set('available_quantity', body.data.available_quantity);"
								]
