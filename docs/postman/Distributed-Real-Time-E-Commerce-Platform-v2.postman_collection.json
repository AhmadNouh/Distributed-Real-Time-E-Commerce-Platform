				{
					"name": "Register",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.collectionVariables.set('random_email', pm.variables.replaceIn('{{$randomEmail}}'));"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('201 Created', function () { pm.response.to.have.status(201); });",
									"var body = pm.response.json();",
									"pm.test('the response carries the new user and a JWT', function () {",
									"    pm.expect(body.success).to.be.true;",
									"    pm.expect(body.data.user.email).to.eql(pm.collectionVariables.get('random_email'));",
									"    pm.expect(body.data.token).to.be.a('string').and.not.empty;",
									"});",
									"pm.collectionVariables.set('register_token', body.data.token);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
