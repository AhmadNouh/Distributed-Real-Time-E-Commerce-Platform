							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('409 Conflict', function () { pm.response.to.have.status(409); });",
									"var body = pm.response.json();",
									"pm.test('the response lists the shortage per product', function () {",
									"    pm.expect(body.errors.stock).to.be.an('array').that.is.not.empty;",
									"    pm.expect(body.errors.stock[0]).to.have.property('product_id');",
									"    pm.expect(body.errors.stock[0]).to.have.property('requested');",
									"    pm.expect(body.errors.stock[0]).to.have.property('available');",
									"});",
									"pm.test('the message is readable by a customer', function () {",
									"    pm.expect(body.message).to.include('Insufficient stock');",
									"});"
